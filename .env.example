# Copy to .env and fill in. .env is gitignored; never commit real keys.

OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Optional: models. Defaults shown. ---

# Talks to the patient — needs conversational quality.
# PRIMARY_AGENT_MODEL=gpt-4o
# Safety models classify rather than converse, so a smaller/faster model keeps
# the Stage 2 latency tax down.
# SAFETY_MODEL=gpt-4o-mini
# SAFETY_TIMEOUT_SECONDS=10

# nova-3, not flux-*: Flux is WebSocket-only on /v2/listen and cannot serve the
# turn-based batch path. Rejected at startup rather than mid-call.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# CARTESIA_MODEL=sonic-2
# Voice name (e.g. Jacqueline) or a raw voice UUID.
# CARTESIA_VOICE=Jacqueline

# --- Optional: audio. Defaults shown. ---

# MIC_SAMPLE_RATE=16000
# TTS_SAMPLE_RATE=24000
# Per-attempt timeout. STT retries once, then escalates the turn.
# AUDIO_TIMEOUT_SECONDS=8
